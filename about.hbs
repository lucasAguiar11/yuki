<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Yuki — third-party licenses</title>
<style>
  body { font: 14px/1.5 ui-monospace, monospace; max-width: 50rem; margin: 2rem auto; padding: 0 1rem; }
  pre { white-space: pre-wrap; background: #f5f5f5; padding: 1rem; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
{{#each licenses}}
<h2>{{name}}</h2>
<p>Used by: {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}</p>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
