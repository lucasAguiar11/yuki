{
  "name": "Yuki",
  "author": "Yuki",
  "themes": [
    {
      "name": "Yuki Console",
      "mode": "dark",
      "font.size": 13,
      "mono_font.family": "Menlo",
      "mono_font.size": 12.5,
      "radius": 4,
      "radius.lg": 8,
      "shadow": false,
      "colors": {
        "background": "#17181c",
        "foreground": "#e4e5e8",
        "border": "#2a2c32",
        "input.border": "#33363d",
        "ring": "#8fb8e8",
        "caret": "#8fb8e8",
        "selection.background": "#8fb8e83d",
        "accent.background": "#23252b",
        "accent.foreground": "#e4e5e8",
        "muted.background": "#1e2025",
        "muted.foreground": "#9a9ea6",
        "primary.background": "#8fb8e8",
        "primary.hover.background": "#a6c7ee",
        "primary.active.background": "#7aa8df",
        "primary.foreground": "#101114",
        "secondary.background": "#23252b",
        "secondary.hover.background": "#2a2c32",
        "secondary.active.background": "#33363d",
        "secondary.foreground": "#e4e5e8",
        "danger.background": "#f08a8a",
        "danger.foreground": "#f08a8a",
        "success.background": "#7ccf95",
        "success.foreground": "#7ccf95",
        "warning.background": "#e0b97a",
        "warning.foreground": "#e0b97a",
        "info.background": "#8fb8e8",
        "info.foreground": "#8fb8e8",
        "popover.background": "#1e2025",
        "popover.foreground": "#e4e5e8",
        "overlay": "#00000080",
        "list.background": "#1e2025",
        "list.hover.background": "#1d1f24",
        "list.active.background": "#262932",
        "list.active.border": "#8fb8e8",
        "list.even.background": "#1e2025",
        "list.head.background": "#1e2025",
        "sidebar.background": "#121317",
        "sidebar.foreground": "#d2d4d8",
        "sidebar.border": "#24262c",
        "sidebar.accent.background": "#1d1f24",
        "sidebar.accent.foreground": "#e4e5e8",
        "sidebar.primary.background": "#8fb8e8",
        "sidebar.primary.foreground": "#101114",
        "tab.background": "#121317",
        "tab.foreground": "#9a9ea6",
        "tab.active.background": "#17181c",
        "tab.active.foreground": "#e4e5e8",
        "tab_bar.background": "#121317",
        "tab_bar.segmented.background": "#1e2025",
        "title_bar.background": "#121317",
        "title_bar.border": "#24262c",
        "status_bar.background": "#121317",
        "status_bar.border": "#24262c",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#e4e5e833",
        "scrollbar.thumb.hover.background": "#e4e5e866",
        "switch.background": "#33363d",
        "window.border": "#2a2c32",
        "drag_border": "#8fb8e8",
        "drop_target.background": "#8fb8e81a",
        "base.red": "#f08a8a",
        "base.red.light": "#f5aaaa",
        "base.green": "#7ccf95",
        "base.green.light": "#a0dcb2",
        "base.blue": "#8fb8e8",
        "base.blue.light": "#b0cdef",
        "base.yellow": "#e0b97a",
        "base.yellow.light": "#ead0a2",
        "base.magenta": "#c9a3e6",
        "base.magenta.light": "#dac0ee",
        "base.cyan": "#82c8cf",
        "base.cyan.light": "#a8d9de"
      },
      "highlight": {
        "editor.foreground": "#d2d4d8",
        "editor.background": "#17181c",
        "editor.active_line.background": "#1d1f24",
        "editor.line_number": "#4a4d55",
        "editor.active_line_number": "#9a9ea6",
        "editor.invisible": "#4a4d55",
        "error.background": "#f08a8a1f",
        "error.border": "#f08a8a",
        "warning.background": "#e0b97a1f",
        "warning.border": "#e0b97a",
        "info.background": "#8fb8e81f",
        "info.border": "#8fb8e8",
        "success.background": "#7ccf951f",
        "syntax": {
          "property": { "color": "#8fb8e8" },
          "string": { "color": "#a6cf98" },
          "string.escape": { "color": "#82c8cf" },
          "string.special": { "color": "#a6cf98" },
          "number": { "color": "#e0b97a" },
          "boolean": { "color": "#c9a3e6" },
          "constant": { "color": "#c9a3e6" },
          "constant.builtin": { "color": "#c9a3e6" },
          "keyword": { "color": "#c9a3e6" },
          "punctuation": { "color": "#7c8089" },
          "punctuation.bracket": { "color": "#9a9ea6" },
          "punctuation.delimiter": { "color": "#7c8089" },
          "comment": { "color": "#7c8089", "font_style": "italic" },
          "tag": { "color": "#8fb8e8" },
          "attribute": { "color": "#e0b97a" },
          "type": { "color": "#82c8cf" },
          "function": { "color": "#8fb8e8" },
          "variable": { "color": "#d2d4d8" }
        }
      }
    }
  ]
}
